<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AoraWindowTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/aora_splash_background</item>
        <item name="android:statusBarColor">@color/aora_splash_background</item>
        <item name="android:navigationBarColor">@color/aora_splash_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>

    <style name="LaunchTheme" parent="AoraWindowTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <style name="NormalTheme" parent="AoraWindowTheme" />
</resources>
